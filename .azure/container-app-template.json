{
    "$schema": "https://schema.management.azure.com/schemas/2019-08-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "containerAppName": {
            "type": "string",
            "defaultValue": "chat-ui",
            "metadata": {
                "description": "Name of the container app"
            }
        },
        "containerAppEnvironmentName": {
            "type": "string",
            "metadata": {
                "description": "Name of the container app environment"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources"
            }
        },
        "acrName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Azure Container Registry"
            }
        },
        "imageName": {
            "type": "string",
            "defaultValue": "chat-ui",
            "metadata": {
                "description": "Name of the container image"
            }
        },
        "imageTag": {
            "type": "string",
            "defaultValue": "latest",
            "metadata": {
                "description": "Tag of the container image"
            }
        },
        "wsUri": {
            "type": "string",
            "metadata": {
                "description": "URI for the WebSocket backend service"
            }
        },
        "minReplicas": {
            "type": "int",
            "defaultValue": 1,
            "metadata": {
                "description": "Minimum number of replicas"
            }
        },
        "maxReplicas": {
            "type": "int",
            "defaultValue": 10,
            "metadata": {
                "description": "Maximum number of replicas"
            }
        }
    },
    "variables": {
        "fullImageName": "[concat(parameters('acrName'), '.azurecr.io/', parameters('imageName'), ':', parameters('imageTag'))]"
    },
    "resources": [
        {
            "type": "Microsoft.App/containerApps",
            "apiVersion": "2022-03-01",
            "name": "[parameters('containerAppName')]",
            "location": "[parameters('location')]",
            "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]",
                "configuration": {
                    "ingress": {
                        "external": true,
                        "targetPort": 80,
                        "allowInsecure": false,
                        "traffic": [
                            {
                                "latestRevision": true,
                                "weight": 100
                            }
                        ]
                    },
                    "registries": [
                        {
                            "server": "[concat(parameters('acrName'), '.azurecr.io')]",
                            "identity": "system"
                        }
                    ]
                },
                "template": {
                    "containers": [
                        {
                            "name": "chat-ui",
                            "image": "[variables('fullImageName')]",
                            "env": [
                                {
                                    "name": "WS_URI",
                                    "value": "[parameters('wsUri')]"
                                }
                            ],
                            "resources": {
                                "cpu": "0.5",
                                "memory": "1Gi"
                            }
                        }
                    ],
                    "scale": {
                        "minReplicas": "[parameters('minReplicas')]",
                        "maxReplicas": "[parameters('maxReplicas')]",
                        "rules": [
                            {
                                "name": "http-scale-rule",
                                "http": {
                                    "metadata": {
                                        "concurrentRequests": "10"
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            "identity": {
                "type": "SystemAssigned"
            }
        }
    ],
    "outputs": {
        "containerAppFqdn": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName'))).configuration.ingress.fqdn]"
        }
    }
}
